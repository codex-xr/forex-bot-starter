{
  "version": 2,
  "functions": {
    "api/*.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/webhook",
      "destination": "/api/webhook.py"
    },
    {
      "source": "/api/set_webhook",
      "destination": "/api/set_webhook.py"
    },
    {
      "source": "/api/cron",
      "destination": "/api/cron.py"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}