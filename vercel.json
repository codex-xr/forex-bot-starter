{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/webhook",
      "destination": "/api/webhook.py"
    },
    {
      "source": "/api/set_webhook",
      "destination": "/api/webhook.py"
    },
    {
      "source": "/api/cron",
      "destination": "/api/webhook.py"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}